<?xml version="1.0" encoding="utf-8"?>
<!--
  The ASTER launcher foreground: the four-point ASTER star (AsterMark.tsx, a
  32-unit path) in its blue-violet gradient over the dark tile set in
  colors.xml. Scaled to 1.8 and centred so the whole star stays inside the 66dp
  safe zone of the 108dp adaptive canvas whatever mask the launcher applies.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.8"
        android:scaleY="1.8"
        android:translateX="25.2"
        android:translateY="25.2">
        <path android:pathData="M16,1.5c1.1,7.6 6.9,13.4 14.5,14.5 -7.6,1.1 -13.4,6.9 -14.5,14.5C14.9,22.9 9.1,17.1 1.5,16 9.1,14.9 14.9,9.1 16,1.5Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="4"
                    android:startY="4"
                    android:endX="28"
                    android:endY="28">
                    <item android:offset="0" android:color="#FF9EC5FF" />
                    <item android:offset="0.55" android:color="#FF7B8CF6" />
                    <item android:offset="1" android:color="#FFA17BF4" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
